<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.thetsajeet</groupId>
	<artifactId>dbv-spring-boot-starter</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>dbv-spring-boot-starter</name>
	<description>Springboot DB validator that runs just after application context is initialized to catch any missing object in database.</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Properties for frontend-maven-plugin configuration -->
		<frontend-maven-plugin.version>1.15.0</frontend-maven-plugin.version>
		<node.version>v20.11.0</node.version>
		<npm.version>10.2.4</npm.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin to manage Node.js and npm for frontend tasks like linting and formatting -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>install node and npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<!-- Install Node.js and npm early in the build lifecycle -->
						<phase>initialize</phase>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
							<npmVersion>${npm.version}</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm install</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<!-- Execute npm install to fetch frontend dependencies after node/npm are installed -->
						<phase>generate-resources</phase>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm run lint:check</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<!-- Run ESLint checks in a later phase to ensure npm install is complete -->
						<phase>process-resources</phase>
						<configuration>
							<arguments>run lint:check</arguments>
							<failOnError>true</failOnError> <!-- Fail the build if any linting issues are found -->
						</configuration>
					</execution>
					<execution>
						<id>npm run format:check</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<!-- Run Prettier format checks in a later phase to ensure npm install is complete -->
						<phase>process-resources</phase>
						<configuration>
							<arguments>run format:check</arguments>
							<failOnError>true</failOnError> <!-- Fail the build if any formatting issues are found -->
						</configuration>
					</execution>
				</executions>
				<!--
				Optional: Configure a working directory if your package.json,
				.eslintrc.js, etc., are not in the project root.
				Example: <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
				-->
			</plugin>
		</plugins>
	</build>

</project>